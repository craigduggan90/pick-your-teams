      "updated": 1786266014863,
      "link": null,
      "locked": false,
      "text": "Reset is not \"Clear\" - that would be \"Unassign All\",\nwhich we don't have in the current design.  Rather,\n\"Reset\" returns the player list to the current \nGetTeams value.  Moving players between teams won't\ncount until someone hits save.",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reset is not \"Clear\" - that would be \"Unassign All\",\nwhich we don't have in the current design.  Rather,\n\"Reset\" returns the player list to the current \nGetTeams value.  Moving players between teams won't\ncount until someone hits save.",
      "autoResize": true,
      "lineHeight": 1.25
    },

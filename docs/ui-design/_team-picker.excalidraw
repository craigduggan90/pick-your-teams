        }
      ],
      "updated": 1786303613545,
      "link": null,
      "locked": false,
      "text": "When they click add, it converts to an X\nand a new + input is appended to the page\n\nWe'll grab the values in all of the\ninvites and send them out.  The order in\nthe request is relevant to the return\nvalues, which will reference field[0].  \n\nIdk if we can work with\nthat or whether we have to template those \nresponse messages",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When they click add, it converts to an X\nand a new + input is appended to the page\n\nWe'll grab the values in all of the invites and send them out.  The order in the request is relevant to the return values, which will reference field[0].  \n\nIdk if we can work with\nthat or whether we have to template those \nresponse messages",
      "autoResize": false,
      "lineHeight": 1.25
    },

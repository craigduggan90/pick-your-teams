    {
      "id": "O6MLAPUuteBRPB-E61ieR",
      "type": "text",
      "x": -15260,
      "y": 1240,
      "width": 620,
      "height": 210,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],

    {
      "id": "gscsJ7hDI5AcXgLJfQPQO",
      "type": "text",
      "x": -12860,
      "y": 1300,
      "width": 620,
      "height": 210,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "q2FOQBFoGWXCJniYMTR48",

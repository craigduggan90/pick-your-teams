      "roundness": null,
      "seed": 115613974,
      "version": 406,
      "versionNonce": 799306198,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786224013906,
      "link": null,
      "locked": false,
      "text": "Your tag is the main way your friends\nwill find you and invite you to games.\nDon't worry if you can't think of the \nperfect tag today, you can always change\nit later (as long as the tag you want is\navailable!) ",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Your tag is the main way your friends will find you and invite you to games.\nDon't worry if you can't think of the \nperfect tag today, you can always change\nit later (as long as the tag you want is\navailable!) ",
      "autoResize": false,
      "lineHeight": 1.25
    },

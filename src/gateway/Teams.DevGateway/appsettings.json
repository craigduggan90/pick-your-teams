{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authoriser": {
    "BaseUrl": "http://localhost:5210"
  },
  "ReverseProxy": {
    "Routes": {
      "teams-api": {
        "ClusterId": "teams-api",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "teams-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5199"
          }
        }
      }
    }
  }
}

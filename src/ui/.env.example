# Copy to .env.local and fill in. .env.local is gitignored (see .gitignore's `*.local` rule).

VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Routed through the Vite dev proxy (vite.config.ts) to the local API.
VITE_API_BASE_URL=/api

# Dev-only: the local API reads Teams-User-* headers instead of a bearer token (see
# docs/claude/stage-2.md). The Vite dev proxy injects these on every /api request, so they must
# match a real user row already seeded in the local Teams.db, or GET /users/self will 404.
VITE_DEV_USER_ID=
VITE_DEV_USER_TAG=
VITE_DEV_USER_NAME=

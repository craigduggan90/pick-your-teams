# Copy to .env.local and fill in. .env.local is gitignored (see .gitignore's `*.local` rule).

VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Routed through the Vite dev proxy (vite.config.ts) to the local API.
VITE_API_BASE_URL=/api

# The proxy's target (Teams.DevGateway in dev, see docs/local-dev-topology.md) is set per-mode
# via .env.development / .env.production, not here — it's the same for every developer.
